@model RaceDayMVC.Models.ParticipantProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h1 class="fw-bold mb-4">👤 My Profile</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            ⚠️ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Profile Picture Card -->
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <div class="mb-3 d-flex justify-content-center">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                             style="width: 120px; height: 120px; font-size: 3rem;">
                            @(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : "?")
                        </div>
                    </div>
                    <h4 class="fw-bold">@Model.FullName</h4>
                    <p class="text-muted mb-1">@Model.Email</p>
                    <span class="badge bg-info">PARTICIPANT</span>
                </div>
            </div>
        </div>

        <!-- Edit Profile Form -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Edit Personal Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name</label>
                                <input asp-for="FullName" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date of Birth</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ID Number</label>
                                <input asp-for="IDNumber" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Emergency Contact</label>
                                <input asp-for="EmergencyContact" class="form-control" />
                            </div>

                            <div class="col-12">
                                <hr />
                                <label class="form-label fw-bold">Profile Picture</label>
                                <input type="file" name="profilePicture" class="form-control" accept="image/*" />
                                <div class="form-text">
                                    Upload a profile photo (JPG, PNG – max 5MB).
                                </div>
                            </div>

                            <div class="col-12 mt-3">
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>