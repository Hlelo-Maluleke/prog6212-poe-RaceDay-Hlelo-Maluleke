        [Fact(DisplayName = "Login_AsOrganizer_ShouldSetIsOrganiserTrue")]
        public void Login_AsOrganizer_ShouldSetIsOrganiserTrue()
        {
            // Arrange
            var loginRequest = new LoginRequest
            {
                Email = "thabo@runningclub.co.za",
                Password = "password123"
            };

            _jwtFixture.MockJwtService
                .Setup(js => js.GenerateToken(It.IsAny<int>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<bool>(), It.IsAny<bool>()))
                .Returns("mock_token");

            // Act
            var result = _controller.Login(loginRequest);

            // Assert
            var okResult = Assert.IsType<OkObjectResult>(result);
            var response = Assert.IsType<LoginResponse>(okResult.Value);
            Assert.True(response.IsOrganiser);
            Assert.False(response.IsParticipant);
        }

        [Fact(DisplayName = "Login_ShouldGenerateJwtToken")]
        public void Login_ShouldGenerateJwtToken()
        {
            // Arrange
            var loginRequest = new LoginRequest
            {
                Email = "lindiwe@runsa.co.za",
                Password = "password123"
            };

            _jwtFixture.MockJwtService
                .Setup(js => js.GenerateToken(It.IsAny<int>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<bool>(), It.IsAny<bool>()))
                .Returns("generated_token");

            // Act
            var result = _controller.Login(loginRequest);

            // Assert
            var okResult = Assert.IsType<OkObjectResult>(result);
            var response = Assert.IsType<LoginResponse>(okResult.Value);
            Assert.Equal("generated_token", response.Token);

            // Verify GenerateToken was called
            _jwtFixture.MockJwtService.Verify(
                js => js.GenerateToken(It.IsAny<int>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<bool>(), It.IsAny<bool>()),
                Times.Once);
        }

        [Fact(DisplayName = "Login_ShouldReturnCorrectUserDetails")]
        public void Login_ShouldReturnCorrectUserDetails()
        {
            // Arrange
            var loginRequest = new LoginRequest
            {
                Email = "michael@cyclezone.co.za",
                Password = "password123"
            };

            _jwtFixture.MockJwtService
                .Setup(js => js.GenerateToken(It.IsAny<int>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<bool>(), It.IsAny<bool>()))
                .Returns("mock_token");

            // Act
            var result = _controller.Login(loginRequest);

            // Assert
            var okResult = Assert.IsType<OkObjectResult>(result);
            var response = Assert.IsType<LoginResponse>(okResult.Value);
            Assert.Equal("michael@cyclezone.co.za", response.Email);
            Assert.Equal("Michael Jacobs", response.FullName);
        }

