        [Fact(DisplayName = "Register_ShouldCreateUserWithHashedPassword")]
        public void Register_ShouldCreateUserWithHashedPassword()
        {
            // Arrange
            var password = "MySecurePassword123";
            var registerRequest = new RegisterRequest
            {
                Email = "secure@test.com",
                Password = password,
                FullName = "Secure User",
                Phone = "082 000 0000"
            };

            // Act
            var result = _controller.Register(registerRequest);

            // Assert
            Assert.IsType<CreatedAtActionResult>(result);
            var user = RaceDayDB.Users.FirstOrDefault(u => u.Email == registerRequest.Email);
            Assert.NotNull(user);

            // Verify password is hashed
            var expectedHash = RaceDayDB.HashPassword(password);
            Assert.Equal(expectedHash, user.PasswordHash);
        }

        #endregion

        #region Login Tests

        [Fact(DisplayName = "Login_WithValidCredentials_ShouldReturnLoginResponse")]
        public void Login_WithValidCredentials_ShouldReturnLoginResponse()
        {
            // Arrange
            var loginRequest = new LoginRequest
            {
                Email = "lindiwe@runsa.co.za",
                Password = "password123"
            };

            // Act
            var result = _controller.Login(loginRequest);

            // Assert
            var okResult = Assert.IsType<OkObjectResult>(result);
            var response = Assert.IsType<LoginResponse>(okResult.Value);
            Assert.NotNull(response.Token);
            Assert.Equal("lindiwe@runsa.co.za", response.Email);
            Assert.True(response.IsParticipant);
            Assert.False(response.IsOrganiser);
        }

