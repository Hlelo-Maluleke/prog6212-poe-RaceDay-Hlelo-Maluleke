using Microsoft.AspNetCore.Mvc;
using RaceDayManagementAPI.Controllers;
using RaceDayManagementAPI.Models;
using RaceDayManagementAPI.Tests.Fixtures;
using Xunit;

namespace RaceDayManagementAPI.Tests.Controllers
{
    public class AuthControllerTests : IClassFixture<RaceDayDBFixture>, IClassFixture<JwtServiceFixture>
    {
        private readonly RaceDayDBFixture _dbFixture;
        private readonly JwtServiceFixture _jwtFixture;
        private readonly AuthController _controller;

        public AuthControllerTests(RaceDayDBFixture dbFixture, JwtServiceFixture jwtFixture)
        {
            _dbFixture = dbFixture;
            _jwtFixture = jwtFixture;
            _controller = new AuthController(_jwtFixture.JwtService);
        }

        #region Register Tests

        [Fact(DisplayName = "Register_WithValidData_ShouldReturnCreatedAtAction")]
        public void Register_WithValidData_ShouldReturnCreatedAtAction()
        {
            // Arrange
            var registerRequest = new RegisterRequest
            {
                Email = "newuser@test.com",
                Password = "Test@12345",
                FullName = "Test User",
                Phone = "082 000 0000",
                DateOfBirth = new DateTime(1990, 5, 15),
                IDNumber = "9005151234567",
                EmergencyContact = "Emergency Contact - 082 111 1111"
            };

            // Act
            var result = _controller.Register(registerRequest);

            // Assert
            var createdResult = Assert.IsType<CreatedAtActionResult>(result);
            Assert.Equal(nameof(AuthController.Register), createdResult.ActionName);
            Assert.NotNull(createdResult.Value);

            // Verify user was added to database
            var user = RaceDayDB.Users.FirstOrDefault(u => u.Email == registerRequest.Email);
            Assert.NotNull(user);
            Assert.Equal(registerRequest.FullName, user.FullName);
            Assert.Equal(registerRequest.Phone, user.Phone);

            // Verify participant was created
            var participant = RaceDayDB.Participants.FirstOrDefault(p => p.UserID == user.UserID);
            Assert.NotNull(participant);
            Assert.Equal(registerRequest.DateOfBirth, participant.DateOfBirth);
            Assert.Equal(registerRequest.IDNumber, participant.IDNumber);
        }

        [Fact(DisplayName = "Register_WithEmptyEmail_ShouldReturnBadRequest")]
        public void Register_WithEmptyEmail_ShouldReturnBadRequest()
        {
            // Arrange
            var registerRequest = new RegisterRequest
            {
                Email = "",
                Password = "Test@12345",
                FullName = "Test User",
                Phone = "082 000 0000"
            };

            // Act
            var result = _controller.Register(registerRequest);

            // Assert
            var badRequestResult = Assert.IsType<BadRequestObjectResult>(result);
            Assert.NotNull(badRequestResult.Value);
        }

        [Fact(DisplayName = "Register_WithEmptyPassword_ShouldReturnBadRequest")]
        public void Register_WithEmptyPassword_ShouldReturnBadRequest()
        {
            // Arrange
            var registerRequest = new RegisterRequest
            {
                Email = "test@test.com",
                Password = "",
                FullName = "Test User",
                Phone = "082 000 0000"
            };

            // Act
            var result = _controller.Register(registerRequest);

            // Assert
            var badRequestResult = Assert.IsType<BadRequestObjectResult>(result);
            Assert.NotNull(badRequestResult.Value);
        }

        [Fact(DisplayName = "Register_WithExistingEmail_ShouldReturnConflict")]
        public void Register_WithExistingEmail_ShouldReturnConflict()
        {
            // Arrange
            var existingEmail = "lindiwe@runsa.co.za"; // Already in database
            var registerRequest = new RegisterRequest
            {
                Email = existingEmail,
                Password = "Test@12345",
                FullName = "New User",
                Phone = "082 000 0000"
            };

            // Act
            var result = _controller.Register(registerRequest);

            // Assert
            var conflictResult = Assert.IsType<ConflictObjectResult>(result);
            Assert.NotNull(conflictResult.Value);
        }

        [Fact(DisplayName = "Register_WithNullFields_ShouldReturnBadRequest")]
        public void Register_WithNullFields_ShouldReturnBadRequest()
        {
            // Arrange
            var registerRequest = new RegisterRequest
            {
                Email = null,
                Password = "Test@12345",
                FullName = "Test User",
                Phone = "082 000 0000"
            };

            // Act
            var result = _controller.Register(registerRequest);

            // Assert
