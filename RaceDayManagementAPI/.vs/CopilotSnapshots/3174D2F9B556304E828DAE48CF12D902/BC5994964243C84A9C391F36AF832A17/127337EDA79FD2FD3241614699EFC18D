using Microsoft.AspNetCore.Http;
using System.Reflection;
using System.Security.Claims;
using System.Text.Json;

namespace RaceDayManagementAPI.Tests.Fixtures
{
    /// <summary>
    /// Helper for creating authenticated controller contexts and accessing anonymous types
    /// </summary>
    public static class ControllerContextHelper
    {
        /// <summary>
        /// Creates a DefaultHttpContext with authenticated user claims
        /// </summary>
        public static DefaultHttpContext CreateAuthenticatedHttpContext(ClaimsPrincipal user)
        {
            var httpContext = new DefaultHttpContext
            {
                User = user
            };
            return httpContext;
        }

        /// <summary>
        /// Safely gets a property value from an anonymous type via reflection
        /// </summary>
        public static T GetAnonymousProperty<T>(object obj, string propertyName)
        {
            if (obj == null) return default;

            var propertyInfo = obj.GetType().GetProperty(propertyName, 
                BindingFlags.IgnoreCase | BindingFlags.Public | BindingFlags.Instance);

            if (propertyInfo == null)
                throw new ArgumentException($"Property '{propertyName}' not found on type '{obj.GetType().Name}'.");

            var value = propertyInfo.GetValue(obj);

            // For complex types or when T is already object, just return the value
            if (typeof(T) == typeof(object) || value == null)
                return (T)(object)value;

            // Only try to convert for primitive types
            if (typeof(T).IsPrimitive || typeof(T) == typeof(string) || typeof(T) == typeof(decimal) || typeof(T) == typeof(DateTime))
            {
                return (T)Convert.ChangeType(value, typeof(T));
            }

            // For other complex types, just cast
            return (T)(object)value;
        }

        /// <summary>
        /// Safely checks if an anonymous type property exists
        /// </summary>
        public static bool HasProperty(object obj, string propertyName)
        {
            if (obj == null) return false;
            var propertyInfo = obj.GetType().GetProperty(propertyName,
                BindingFlags.IgnoreCase | BindingFlags.Public | BindingFlags.Instance);
            return propertyInfo != null;
        }

        /// <summary>
        /// Converts an anonymous type object to a dictionary for easier assertions
        /// </summary>
        public static Dictionary<string, object> AnonymousToDictionary(object obj)
        {
            if (obj == null) return new Dictionary<string, object>();

            var json = JsonSerializer.Serialize(obj);
            var dict = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);
            var result = new Dictionary<string, object>();

            if (dict != null)
            {
                foreach (var kvp in dict)
                {
                    result[kvp.Key] = ConvertJsonElement(kvp.Value);
                }
            }

            return result;
        }

        private static object ConvertJsonElement(JsonElement element)
        {
            return element.ValueKind switch
            {
                JsonValueKind.String => element.GetString(),
                JsonValueKind.Number => element.GetDecimal(),
                JsonValueKind.True => true,
                JsonValueKind.False => false,
                JsonValueKind.Null => null,
                _ => element.ToString()
            };
        }
    }
}
