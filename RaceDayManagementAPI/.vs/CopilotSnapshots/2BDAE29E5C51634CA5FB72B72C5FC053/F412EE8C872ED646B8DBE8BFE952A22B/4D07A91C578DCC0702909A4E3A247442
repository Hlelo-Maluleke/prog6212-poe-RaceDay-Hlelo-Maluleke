        #region General CRUD Tests

        [Fact(DisplayName = "CRUD_CompleteLifecycle_CreateReadUpdateDelete")]
        public void CRUD_CompleteLifecycle_CreateReadUpdateDelete()
        {
            // This test demonstrates the complete CRUD lifecycle
            int organiserUserId = 1;
            var claims = _jwtFixture.CreateOrganizerClaims(organiserUserId);
            _controller.ControllerContext.HttpContext = new Microsoft.AspNetCore.Http.DefaultHttpContext { User = claims };

            // CREATE
            var createRequest = new CreateEventRequest
            {
                Name = "CRUD Lifecycle Test Event",
                Description = "Testing complete CRUD cycle",
                Location = "CRUD Test City",
                EventDate = new DateTime(2027, 5, 22),
                StartTime = new TimeSpan(7, 30, 0),
                EventType = "run",
                Status = "draft"
            };

            var createResult = _controller.CreateEvent(createRequest);
            Assert.IsType<CreatedAtActionResult>(createResult);
            var createdEvent = (createResult as CreatedAtActionResult)?.Value as Event;
            Assert.NotNull(createdEvent);
            int eventId = createdEvent.EventID;

            // READ
            _controller.ControllerContext.HttpContext = new Microsoft.AspNetCore.Http.DefaultHttpContext();
            var readResult = _controller.GetEvent(eventId);
            Assert.IsType<OkObjectResult>(readResult);

            // UPDATE
            _controller.ControllerContext.HttpContext = new Microsoft.AspNetCore.Http.DefaultHttpContext { User = claims };
            var updateRequest = new UpdateEventRequest
            {
                Name = "CRUD Lifecycle Test Event - Updated",
                Status = "published"
            };

            var updateResult = _controller.UpdateEvent(eventId, updateRequest);
            Assert.IsType<OkObjectResult>(updateResult);
            var updatedEvent = (updateResult as OkObjectResult)?.Value as Event;
            Assert.Equal("CRUD Lifecycle Test Event - Updated", updatedEvent?.Name);

            // DELETE
            var deleteResult = _controller.DeleteEvent(eventId);
            Assert.IsType<NoContentResult>(deleteResult);

            // Verify deletion
            _controller.ControllerContext.HttpContext = new Microsoft.AspNetCore.Http.DefaultHttpContext();
            var verifyDeleteResult = _controller.GetEvent(eventId);
            Assert.IsType<NotFoundObjectResult>(verifyDeleteResult);
        }

