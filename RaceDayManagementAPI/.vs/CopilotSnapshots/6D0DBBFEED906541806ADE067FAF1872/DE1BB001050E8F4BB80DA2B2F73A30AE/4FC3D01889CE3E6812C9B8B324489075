using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using RaceDayManagementAPI.Models;
using RaceDayManagementAPI.Services;

namespace RaceDayManagementAPI.Controllers
{
    [ApiController]
    [Route("api/organisers")]
    [Authorize]
    public class OrganiserController : ControllerBase
    {
        private readonly JwtService _jwtService;

        public OrganiserController(JwtService jwtService)
        {
            _jwtService = jwtService;
        }

        // 1. GET OWN PROFILE
        [HttpGet("user")]
        public IActionResult GetMyProfile()
        {
            var userId = _jwtService.GetUserIdFromToken(User);
            var organiser = RaceDayDB.Organisers.FirstOrDefault(o => o.UserID == userId);

            if (organiser == null)
                return NotFound(new { message = "You are not registered as an organiser." });

            var user = RaceDayDB.Users.FirstOrDefault(u => u.UserID == userId);

            return Ok(new
            {
                organiser.OrganiserID,
                organiser.CompanyName,
                User = new
                {
                    user?.UserID,
                    user?.Email,
                    user?.FullName,
                    user?.Phone
                },
                organiser.CreatedAt,
                organiser.UpdatedAt
            });
        }

        // 2. UPDATE OWN PROFILE
        [HttpPut("user")]
        public IActionResult UpdateMyProfile([FromBody] UpdateOrganiserRequest request)
        {
            var userId = _jwtService.GetUserIdFromToken(User);
            var user = RaceDayDB.Users.FirstOrDefault(u => u.UserID == userId);
            var organiser = RaceDayDB.Organisers.FirstOrDefault(o => o.UserID == userId);

            if (user == null || organiser == null)
                return NotFound(new { message = "Organiser not found." });

            // Update User fields
            if (!string.IsNullOrEmpty(request.FullName))
                user.FullName = request.FullName;
            if (!string.IsNullOrEmpty(request.Phone))
                user.Phone = request.Phone;
            if (!string.IsNullOrEmpty(request.Email))
            {
                var existing = RaceDayDB.Users.FirstOrDefault(u => u.Email == request.Email && u.UserID != userId);
                if (existing != null)
                    return Conflict(new { message = "Email already in use." });
                user.Email = request.Email;
            }
            user.UpdatedAt = DateTime.Now;

            // Update Organiser fields
            if (!string.IsNullOrEmpty(request.CompanyName))
                organiser.CompanyName = request.CompanyName;
            organiser.UpdatedAt = DateTime.Now;

            return Ok(new
            {
                organiser.OrganiserID,
                organiser.CompanyName,
                User = new
                {
                    user.UserID,
                    user.Email,
                    user.FullName,
                    user.Phone
                },
                organiser.UpdatedAt
            });
        }

        // 3. GET OWN EVENTS
        [HttpGet("user/events")]
        public IActionResult GetMyEvents()
        {
            var userId = _jwtService.GetUserIdFromToken(User);
            var organiser = RaceDayDB.Organisers.FirstOrDefault(o => o.UserID == userId);

            if (organiser == null)
                return NotFound(new { message = "Organiser not found." });

            var events = RaceDayDB.Events
                .Where(e => e.OrganiserID == organiser.OrganiserID)
                .ToList();

            return Ok(events);
        }

        // 4. GET ENROLMENTS FOR MY EVENT
        [HttpGet("user/events/{eventId}/enrolments")]
        public IActionResult GetEventEnrolments(int eventId)
        {
            var userId = _jwtService.GetUserIdFromToken(User);
            var organiser = RaceDayDB.Organisers.FirstOrDefault(o => o.UserID == userId);

            if (organiser == null)
                return NotFound(new { message = "Organiser not found." });

            var eventEntity = RaceDayDB.Events
                .FirstOrDefault(e => e.EventID == eventId && e.OrganiserID == organiser.OrganiserID);

            if (eventEntity == null)
                return NotFound(new { message = "Event not found or you do not own it." });

            var categoryIds = RaceDayDB.Categories
                .Where(c => c.EventID == eventId)
                .Select(c => c.CategoryID)
                .ToList();

            var enrolments = RaceDayDB.Enrolments
                .Where(e => categoryIds.Contains(e.CategoryID))
                .ToList();

            return Ok(enrolments);
        }
    }

    public class UpdateOrganiserRequest
    {
        public string? FullName { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? CompanyName { get; set; }
    }
}