using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using RaceDayManagementAPI.Models;
using RaceDayManagementAPI.Services;

namespace RaceDayManagementAPI.Controllers
{
    [ApiController]
    [Route("api/auth")]
    public class AuthController : ControllerBase
    {
        private readonly JwtService _jwtService;

        public AuthController(JwtService jwtService)
        {
            _jwtService = jwtService;
        }

        // 1. REGISTER - Creates a new Participant account only
        [HttpPost("register")]
        public IActionResult Register([FromBody] RegisterRequest request)
        {
            // Validate
            if (string.IsNullOrEmpty(request.Email) || string.IsNullOrEmpty(request.Password))
            {
                return BadRequest(new { message = "Email and password are required." });
            }

            // Check if email already exists
            var existingUser = RaceDayDB.Users.FirstOrDefault(u => u.Email == request.Email);
            if (existingUser != null)
            {
                return Conflict(new { message = "Email already registered." });
            }

            // Hash password
            var passwordHash = RaceDayDB.HashPassword(request.Password);

            // Create User
            var user = new User
            {
                UserID = RaceDayDB.NextUserID++,
                Email = request.Email,
                PasswordHash = passwordHash,
                FullName = request.FullName,
                Phone = request.Phone
            };
            RaceDayDB.Users.Add(user);

            // Create Participant (automatically - organisers are pre-seeded)
            var participant = new Participant
            {
                ParticipantID = RaceDayDB.NextParticipantID++,
                UserID = user.UserID,
                DateOfBirth = request.DateOfBirth,
                IDNumber = request.IDNumber,
                EmergencyContact = request.EmergencyContact
            };
            RaceDayDB.Participants.Add(participant);

            // Return user object (without password)
            return CreatedAtAction(nameof(Register), new { id = user.UserID }, new
            {
                user.UserID,
                user.Email,
                user.FullName,
                user.Phone,
                user.CreatedAt
            });
        }

        // 2. LOGIN - Authenticates user and returns JWT token
        [HttpPost("login")]
        public IActionResult Login([FromBody] LoginRequest request)
        {
            // Find user by email
            var user = RaceDayDB.Users.FirstOrDefault(u => u.Email == request.Email);
            if (user == null)
            {
                return Unauthorized(new { message = "Invalid email or password." });
            }

            // Verify password
            var passwordHash = RaceDayDB.HashPassword(request.Password);
            if (user.PasswordHash != passwordHash)
            {
                return Unauthorized(new { message = "Invalid email or password." });
            }

            // Check if user is an organiser
            var isOrganiser = RaceDayDB.Organisers.Any(o => o.UserID == user.UserID);
            var isParticipant = RaceDayDB.Participants.Any(p => p.UserID == user.UserID);

            // Generate JWT token
            var token = _jwtService.GenerateToken(
                user.UserID,
                user.Email,
                user.FullName,
                isOrganiser,
                isParticipant
            );

            return Ok(new LoginResponse
            {
                Token = token,
                UserID = user.UserID,
                FullName = user.FullName,
                Email = user.Email,
                IsOrganiser = isOrganiser,
                IsParticipant = isParticipant
            });
        }
    }
}

