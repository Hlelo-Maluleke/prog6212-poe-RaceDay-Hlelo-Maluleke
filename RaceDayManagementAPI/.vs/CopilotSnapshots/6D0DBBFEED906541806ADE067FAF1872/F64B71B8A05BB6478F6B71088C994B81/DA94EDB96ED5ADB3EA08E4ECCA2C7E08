using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using RaceDayManagementAPI.Data;
using RaceDayManagementAPI.Models;
using RaceDayManagementAPI.Services;

namespace RaceDayManagementAPI.Controllers
{
    [ApiController]
    [Route("api")]
    public class ResultsController : ControllerBase
    {
        private readonly JwtService _jwtService;
        private readonly RaceDayDbContext _dbContext;

        public ResultsController(JwtService jwtService, RaceDayDbContext dbContext)
        {
            _jwtService = jwtService;
            _dbContext = dbContext;
        }

        // 1. CAPTURE/UPDATE RESULT (UPSERT)
        //    →  POST /api/enrolments/{enrolmentId}/results
        [HttpPost("enrolments/{enrolmentId}/results")]
        [Authorize]
        public IActionResult CaptureResult(int enrolmentId, [FromBody] ResultRequest request)
        {
            var enrolment = _dbContext.Enrolments.FirstOrDefault(e => e.EnrolmentID == enrolmentId);
            if (enrolment == null)
                return NotFound(new { message = "Enrolment not found." });

            var category = _dbContext.Categories.FirstOrDefault(c => c.CategoryID == enrolment.CategoryID);
            var eventEntity = category != null ? _dbContext.Events.FirstOrDefault(e => e.EventID == category.EventID) : null;
            var organiser = eventEntity != null ? _dbContext.Organisers.FirstOrDefault(o => o.OrganiserID == eventEntity.OrganiserID) : null;

            var userId = _jwtService.GetUserIdFromToken(User);
            if (organiser?.UserID != userId)
                return Forbid("Only the event organiser can capture results.");

            var existingResult = _dbContext.Results.FirstOrDefault(r => r.EnrolmentID == enrolmentId);

            if (existingResult != null)
            {
                // Update
                existingResult.FinishTimeSeconds = request.FinishTimeSeconds;
                existingResult.Position = request.Position;
                existingResult.Status = request.Status ?? "finished";
                existingResult.UpdatedAt = DateTime.Now;
                _dbContext.SaveChanges();

                return Ok(existingResult);
            }
            else
            {
                // Create
                var result = new Result
                {
                    EnrolmentID = enrolmentId,
                    OrganiserID = organiser.OrganiserID,
                    FinishTimeSeconds = request.FinishTimeSeconds,
                    Position = request.Position,
                    Status = request.Status ?? "finished"
                };
                _dbContext.Results.Add(result);
                _dbContext.SaveChanges();

                return CreatedAtAction(nameof(GetEventResults), new { eventId = eventEntity?.EventID }, result);
            }
        }

        // 2. GET RESULTS FOR EVENT (PUBLIC)
        //    →  GET /api/events/{eventId}/results
        [HttpGet("events/{eventId}/results")]
        [AllowAnonymous]
        public IActionResult GetEventResults(int eventId)
        {
            var eventExists = _dbContext.Events.Any(e => e.EventID == eventId);
            if (!eventExists)
                return NotFound(new { message = "Event not found." });

            var categoryIds = _dbContext.Categories
                .Where(c => c.EventID == eventId)
                .Select(c => c.CategoryID)
                .ToList();

            var enrolmentIds = _dbContext.Enrolments
                .Where(e => categoryIds.Contains(e.CategoryID))
                .Select(e => e.EnrolmentID)
                .ToList();

            var results = _dbContext.Results
                .Where(r => enrolmentIds.Contains(r.EnrolmentID))
                .OrderBy(r => r.Position)
                .ToList()
                .Select(r =>
                {
                    var enrolment = _dbContext.Enrolments.FirstOrDefault(e => e.EnrolmentID == r.EnrolmentID);
                    var participant = enrolment != null ? _dbContext.Participants.FirstOrDefault(p => p.ParticipantID == enrolment.ParticipantID) : null;
                    var pUser = participant != null ? _dbContext.Users.FirstOrDefault(u => u.UserID == participant.UserID) : null;
                    var category = enrolment != null ? _dbContext.Categories.FirstOrDefault(c => c.CategoryID == enrolment.CategoryID) : null;

                    return new
                    {
                        r.ResultID,
                        r.Position,
                        r.FinishTimeSeconds,
                        r.Status,
                        Participant = new
                        {
                            ParticipantID = participant == null ? (int?)null : participant.ParticipantID,
                            FullName = pUser == null ? null : pUser.FullName
                        },
                        Category = new
                        {
                            CategoryID = category == null ? (int?)null : category.CategoryID,
                            Name = category == null ? null : category.Name,
                            DistanceKm = category == null ? 0 : category.DistanceKm
                        }
                    };
                })
                .ToList();

            return Ok(results);
        }

        // 3. GET MY RESULTS (PARTICIPANT)
        //    →  GET /api/participants/user/results  (already in ParticipantController)
        [HttpGet("results/user")]
        [Authorize]
        public IActionResult GetMyResults()
        {
            var userId = _jwtService.GetUserIdFromToken(User);
            var participant = _dbContext.Participants.FirstOrDefault(p => p.UserID == userId);

            if (participant == null)
                return Forbid("Only participants can view their results.");

            var enrolmentIds = _dbContext.Enrolments
                .Where(e => e.ParticipantID == participant.ParticipantID)
                .Select(e => e.EnrolmentID)
                .ToList();

            var results = _dbContext.Results
                .Where(r => enrolmentIds.Contains(r.EnrolmentID))
                .Select(r =>
                {
                    var enrolment = _dbContext.Enrolments.FirstOrDefault(e => e.EnrolmentID == r.EnrolmentID);
                    var category = enrolment != null ? _dbContext.Categories.FirstOrDefault(c => c.CategoryID == enrolment.CategoryID) : null;
                    var eventEntity = category != null ? _dbContext.Events.FirstOrDefault(ev => ev.EventID == category.EventID) : null;

                    return new
                    {
                        r.ResultID,
                        r.Position,
                        r.FinishTimeSeconds,
                        r.Status,
                        r.CreatedAt,
                        Event = eventEntity == null ? null : new
                        {
                            eventEntity.EventID,
                            eventEntity.Name,
                            eventEntity.EventDate,
                            eventEntity.Location
                        },
                        Category = category == null ? null : new
                        {
                            category.CategoryID,
                            category.Name,
                            category.DistanceKm
                        }
                    };
                })
                .ToList();

            return Ok(results);
        }

        // 4. GET SINGLE RESULT  →  GET /api/results/{id}
        [HttpGet("results/{id}")]
        [AllowAnonymous]
        public IActionResult GetResult(int id)
        {
            var result = _dbContext.Results.FirstOrDefault(r => r.ResultID == id);
            if (result == null)
                return NotFound(new { message = "Result not found." });

            return Ok(result);
        }
    }

    // Request Models
    public class ResultRequest
    {
        public int? FinishTimeSeconds { get; set; }
        public int? Position { get; set; }
        public string? Status { get; set; }
    }
}