@model RaceDayMVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h3>🏁😫 RaceDay Register</h3>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }
                    <form method="post">
                        <div class="mb-3">
                            <label>FullName</label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Email</label>
                            <input asp-for="Email" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Password</label>
                            <input asp-for="Password" type="password" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Phone</label>
                            <input asp-for="Phone" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>DateOfBirth</label>
                            <input asp-for="DateOfBirth" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>IDNumber</label>
                            <input asp-for="IDNumber" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>EmergencyContact</label>
                            <input asp-for="EmergencyContact" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Register</button>
                    </form>
                    <hr />
                    <p class="text-center">
                        Don't have an account?
                        <a asp-action="Register">Register as Participant</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
