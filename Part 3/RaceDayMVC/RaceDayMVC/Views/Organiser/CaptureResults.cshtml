@model List<RaceDayMVC.Models.EnrolmentViewModel>
@{
    ViewData["Title"] = "Capture Results";
    int eventId = ViewBag.EventId ?? 0;
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Back to Dashboard</a>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">📊 Capture Results</h1>
        <span class="badge bg-primary fs-6">@Model.Count participants</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            ⚠️ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4>No enrolled participants yet</h4>
            <p>Once participants enrol, you can capture their results here.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-3">
                    For each participant, enter their finish time and position.
                    Click <strong>Save</strong> to publish the result.
                </p>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Finish Time (sec)</th>
                                <th>Position</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrolment in Model.OrderBy(e => e.Participant?.FullName))
                            {
                                <tr>
                                    <td>
                                        <strong>@enrolment.Participant?.FullName</strong>
                                        <div class="small text-muted">@enrolment.Category?.Name</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@enrolment.Category?.DistanceKm km</span>
                                    </td>
                                    <td colspan="4">
                                        <form asp-action="CaptureResult" method="post" class="row g-2">
                                            <input type="hidden" name="enrolmentId" value="@enrolment.EnrolmentID" />
                                            <input type="hidden" name="eventId" value="@eventId" />

                                            <div class="col-md-3">
                                                <input type="number" name="finishTimeSeconds" min="1"
                                                       class="form-control form-control-sm"
                                                       placeholder="e.g. 6300"
                                                       value="@(enrolment.Result?.FinishTimeSeconds ?? 0)" />
                                            </div>
                                            <div class="col-md-2">
                                                <input type="number" name="position" min="1"
                                                       class="form-control form-control-sm"
                                                       placeholder="e.g. 42"
                                                       value="@(enrolment.Result?.Position ?? 0)" />
                                            </div>
                                            <div class="col-md-3">
                                                <select name="status" class="form-select form-select-sm">
                                                    <option value="finished">✅ Finished</option>
                                                    <option value="dnf">❌ DNF</option>
                                                    <option value="dsq">⚠️ DSQ</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <button type="submit" class="btn btn-success btn-sm w-100">
                                                    💾 Save Result
                                                </button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                                @if (enrolment.Result != null && enrolment.Result.FinishTimeSeconds.HasValue)
                                {
                                    <tr class="table-light">
                                        <td colspan="6" class="small">
                                            <strong>Current result:</strong>
                                            @FormatTime(enrolment.Result.FinishTimeSeconds.Value) —
                                            Position @enrolment.Result.Position —
                                            Status: <span class="badge bg-info">@enrolment.Result.FinishTimeSeconds</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string FormatTime(int seconds)
    {
        var hours = seconds / 3600;
        var minutes = (seconds % 3600) / 60;
        var secs = seconds % 60;

        if (hours > 0)
            return $"{hours}h {minutes}m {secs}s";
        return $"{minutes}m {secs}s";
    }
}